# Website contact forms (support + suggestions) via Resend.
# Set these in Vercel → Project → Settings → Environment Variables (Production + Preview).

RESEND_API_KEY=
# Optional overrides (defaults shown):
# RESEND_FROM_EMAIL=Choremaxx <noreply@choremaxx.app>
# CONTACT_TO_EMAIL=support@choremaxx.app

# Google Search Console — durable ownership verification.
# Paste the token from the "HTML tag" method (the content="..." value, not the
# whole tag). Renders <meta name="google-site-verification"> on every page.
# GOOGLE_SITE_VERIFICATION=
